<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>shizhong-xpub</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same derivation code as the server, so the addresses shown here are exactly the ones members get. -->
    <Compile Include="../../Shizhong.Api/Modules/Finance/Crypto/HdKeys.cs" Link="HdKeys.cs" />
    <PackageReference Include="NBitcoin" Version="10.0.13" />
    <PackageReference Include="Nethereum.Util" Version="6.1.0" />
  </ItemGroup>

</Project>
