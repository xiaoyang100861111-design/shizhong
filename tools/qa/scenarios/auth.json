[
 {
  "name": "auth-welcome",
  "hash": "home",
  "session": "none",
  "steps": [
   {"expect": "!!document.querySelector('[data-auth=welcome]') && SZ.overlay.depth()===1", "msg": "welcome shown on first visit"},
   {"key": "Escape"},
   {"back": true},
   {"wait": 400},
   {"expect": "!!document.querySelector('[data-auth=welcome]') && SZ.overlay.depth()===1", "msg": "gate cannot be dismissed with Escape/back"},
   {"expect": "!document.querySelector('[data-auth=welcome] [data-action=close]')", "msg": "gate has no close button"}
  ]
 },
 {
  "name": "auth-welcome-language",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-action=auth-lang]"},
   {"expect": "SZ.overlay.top().meta.auth==='language'", "msg": "language sheet"},
   {"shot": "sheet"},
   {"back": true},
   {"expect": "SZ.overlay.top().meta.auth==='welcome'", "msg": "back returns to welcome"}
  ]
 },
 {
  "name": "auth-welcome-terms",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": ".auth-welcome .auth-legal [data-id=privacy]"},
   {"expect": "SZ.overlay.top().meta.auth==='legal'", "msg": "privacy summary sheet"}
  ]
 },
 {
  "name": "auth-phone-register",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-phone]"},
   {"expect": "document.querySelector('[data-auth=phone] [type=submit]').disabled", "msg": "send disabled while empty"},
   {"type": "[data-auth=phone] .auth-phone-input", "value": "12345"},
   {"eval": "document.querySelector('[data-auth=phone] .auth-phone-input').dispatchEvent(new Event('blur')),true"},
   {"expect": "!document.querySelector('[data-auth=phone] .form-error').hidden", "msg": "short number shows an error"},
   {"eval": "(()=>{const e=document.querySelector('[data-auth=phone] .auth-phone-input');e.value='017'+String(Date.now()).slice(-7);e.dispatchEvent(new Event('input',{bubbles:true}));return true})()"},
   {"expect": "!document.querySelector('[data-auth=phone] [type=submit]').disabled && document.querySelector('[data-auth=phone] .form-error').hidden", "msg": "valid number (leading 0 ignored) enables send"},
   {"shot": "phone"},
   {"submit": "[data-auth=phone] form"},
   {"expect": "/^\\d{6}$/.test(document.querySelector('.auth-sms [data-code]').dataset.code)", "msg": "demo SMS shows the code"},
   {"shot": "code"},
   {"type": "[data-auth=code] .auth-code-input", "value": "000000"},
   {"expect": "!document.querySelector('[data-auth=code] .auth-code-error').hidden && SZ.overlay.top().meta.auth==='code'", "msg": "wrong code rejected"},
   {"shot": "code-wrong"},
   {"eval": "(()=>{const c=document.querySelector('.auth-sms [data-code]').dataset.code;const e=document.querySelector('[data-auth=code] .auth-code-input');e.value=c.slice(0,3)+' '+c.slice(3);e.dispatchEvent(new Event('input',{bubbles:true}));return true})()"},
   {"expect": "SZ.overlay.top().meta.auth==='account' && !document.querySelector('[data-auth=code]')", "msg": "code accepted, password step replaces the code screen"},
   {"type": "[data-auth=account] input[name=password]", "value": "abcdefgh"},
   {"eval": "document.querySelector('[data-auth=account] input[name=password]').dispatchEvent(new Event('blur')),true"},
   {"expect": "!document.querySelector('[data-auth=account] .form-group .form-error').hidden", "msg": "letters-only password is rejected"},
   {"type": "[data-auth=account] input[name=password]", "value": "panda2026"},
   {"click": "[data-auth=account] input[name=age]"},
   {"expect": "document.querySelector('[data-auth=account] [type=submit]').disabled", "msg": "continue needs both required boxes"},
   {"click": "[data-auth=account] input[name=terms]"},
   {"expect": "!document.querySelector('[data-auth=account] [type=submit]').disabled", "msg": "continue enabled"},
   {"shot": "account"},
   {"submit": "[data-auth=account] form"},
   {"expect": "SZ.overlay.top().meta.auth==='profile' && document.querySelector('[data-auth=profile] [type=submit]').disabled", "msg": "profile step, finish disabled until nickname"},
   {"type": "[data-auth=profile] input[name=nickname]", "value": "Lin Mei"},
   {"click": "[data-auth=profile] [data-act=city][data-value='槟城']"},
   {"click": "[data-auth=profile] [data-act=interest][data-value=food]"},
   {"click": "[data-auth=profile] [data-act=interest][data-value=travel]"},
   {"shot": "profile"},
   {"submit": "[data-auth=profile] form", "settle": 2500},
   {"expect": "window.SZ_BOOTED && SZ.session.isLoggedIn && !SZ.session.isDemo", "msg": "new account signed in"},
   {"expect": "state.profile.name==='Lin Mei' && state.wallet===100 && state.profile.interests.join()==='food,travel'", "msg": "starting state"},
   {"expect": "state.city==='槟城'", "msg": "city"},
   {"expect": "SZ.overlay.depth()===0", "msg": "no auth screen after reload"}
  ]
 },
 {
  "name": "auth-phone-back",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-phone]"},
   {"type": "[data-auth=phone] .auth-phone-input", "value": "123456789"},
   {"submit": "[data-auth=phone] form"},
   {"expect": "SZ.overlay.top().meta.auth==='code'", "msg": "code screen"},
   {"back": true},
   {"expect": "SZ.overlay.top().meta.auth==='phone' && SZ.overlay.depth()===2", "msg": "back from code returns to phone"},
   {"back": true},
   {"expect": "SZ.overlay.top().meta.auth==='welcome' && SZ.overlay.depth()===1", "msg": "back from phone returns to welcome"}
  ]
 },
 {
  "name": "auth-phone-existing",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-phone]"},
   {"type": "[data-auth=phone] .auth-phone-input", "value": "12-345 6789"},
   {"submit": "[data-auth=phone] form"},
   {"expect": "!document.querySelector('[data-auth=code] .auth-step')", "msg": "existing number: sign-in, no sign-up steps"},
   {"click": ".auth-sms [data-sms=fill]", "settle": 2500},
   {"expect": "window.SZ_BOOTED && SZ.session.isDemo", "msg": "code sign-in to the demo account"},
   {"expect": "state.wallet > 1000000 && state.profile.name !== t('shell.guestName')", "msg": "demo data kept (guest state not written over it)"}
  ]
 },
 {
  "name": "auth-country-picker",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-phone]"},
   {"click": "[data-auth=phone] [data-act=country]"},
   {"expect": "SZ.overlay.top().meta.auth==='country'", "msg": "country sheet"},
   {"shot": "sheet"},
   {"click": "[data-country=SG]"},
   {"expect": "SZ.overlay.top().meta.auth==='phone' && document.querySelector('.auth-cc-dial').textContent==='+65'", "msg": "picked +65, phone form kept"},
   {"type": "[data-auth=phone] .auth-phone-input", "value": "+60 12 345 6789"},
   {"expect": "document.querySelector('.auth-cc-dial').textContent==='+60'", "msg": "pasted international number switches country"}
  ]
 },
 {
  "name": "auth-email-signin",
  "hash": "home",
  "session": "none",
  "setup": ["localStorage.removeItem('sz:v2:auth-throttle')"],
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-email]"},
   {"type": "[data-auth=email] input[name=email]", "value": "demo@shizhong.my"},
   {"type": "[data-auth=email] input[name=password]", "value": "shizhong2026"},
   {"shot": "form"},
   {"submit": "[data-auth=email] form", "settle": 2500},
   {"expect": "window.SZ_BOOTED && SZ.session.isDemo && SZ.overlay.depth()===0", "msg": "signed in to the demo account"},
   {"expect": "state.wallet > 1000000", "msg": "demo data kept"}
  ]
 },
 {
  "name": "auth-email-wrong-password",
  "hash": "home",
  "session": "none",
  "setup": ["localStorage.removeItem('sz:v2:auth-throttle')"],
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-email]"},
   {"type": "[data-auth=email] input[name=email]", "value": "demo@shizhong.my"},
   {"type": "[data-auth=email] input[name=password]", "value": "wrongpass1"},
   {"submit": "[data-auth=email] form"},
   {"expect": "!document.querySelector('[data-auth=email] input[name=password]').closest('.form-group').querySelector('.form-error').hidden", "msg": "wrong password error"},
   {"shot": "wrong"},
   {"submit": "[data-auth=email] form"},
   {"submit": "[data-auth=email] form"},
   {"submit": "[data-auth=email] form"},
   {"submit": "[data-auth=email] form"},
   {"expect": "document.querySelector('[data-auth=email] [type=submit]').disabled && !SZ.session.isLoggedIn", "msg": "5 wrong tries start a cooldown"},
   {"eval": "localStorage.removeItem('sz:v2:auth-throttle'),true"}
  ]
 },
 {
  "name": "auth-email-create",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-email]"},
   {"click": "[data-auth=email] [role=tab][data-value=create]"},
   {"type": "[data-auth=email] input[name=email]", "value": "demo@shizhong.my"},
   {"type": "[data-auth=email] input[name=password]", "value": "short1"},
   {"eval": "document.querySelector('[data-auth=email] input[name=password]').dispatchEvent(new Event('blur')),true"},
   {"expect": "document.querySelector('[data-auth=email] [type=submit]').disabled", "msg": "weak password keeps the button disabled"},
   {"type": "[data-auth=email] input[name=password]", "value": "longer2026"},
   {"submit": "[data-auth=email] form"},
   {"expect": "!!document.querySelector('[data-auth=email] [data-act=to-signin]')", "msg": "existing email offers sign-in"},
   {"shot": "exists"},
   {"eval": "(()=>{const e=document.querySelector('[data-auth=email] input[name=email]');e.value='new'+Date.now()+'@example.com';e.dispatchEvent(new Event('input',{bubbles:true}));return true})()"},
   {"submit": "[data-auth=email] form"},
   {"expect": "SZ.overlay.top().meta.auth==='code' && !!document.querySelector('.auth-sms [data-code]')", "msg": "email code sent"},
   {"click": ".auth-sms [data-sms=fill]"},
   {"expect": "SZ.overlay.top().meta.auth==='account' && !document.querySelector('[data-auth=account] input[name=password]')", "msg": "consent only (password already set)"}
  ]
 },
 {
  "name": "auth-forgot",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-email]"},
   {"click": "[data-auth=email] [data-act=forgot]"},
   {"expect": "SZ.overlay.top().meta.auth==='forgot'", "msg": "forgot screen"},
   {"type": "[data-auth=forgot] .auth-phone-input", "value": "199999999"},
   {"submit": "[data-auth=forgot] form"},
   {"expect": "!document.querySelector('.auth-forgot-error').hidden", "msg": "unknown number"},
   {"type": "[data-auth=forgot] .auth-phone-input", "value": "123456789"},
   {"shot": "form"},
   {"submit": "[data-auth=forgot] form"},
   {"click": ".auth-sms [data-sms=fill]"},
   {"expect": "SZ.overlay.top().meta.auth==='new-password'", "msg": "new password step"},
   {"type": "[data-auth=new-password] input[name=password]", "value": "panda2026"},
   {"expect": "!document.querySelector('[data-auth=new-password] [type=submit]').disabled", "msg": "save enabled"}
  ]
 },
 {
  "name": "auth-provider-google",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-provider][data-id=google]"},
   {"expect": "SZ.overlay.top().meta.auth==='provider'", "msg": "consent sheet"},
   {"shot": "consent"},
   {"click": ".auth-oauth [data-act=allow]", "settle": 1400},
   {"expect": "SZ.overlay.top().meta.auth==='account' && !document.querySelector('[data-auth=account] input[name=password]')", "msg": "new provider account: consent step"}
  ]
 },
 {
  "name": "auth-guest-gated",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-guest]"},
   {"expect": "SZ.overlay.depth()===0 && SZ.session.has && SZ.session.isGuest", "msg": "guest browsing"},
   {"eval": "SZ.requireLogin(t('auth.reason.order'))===false"},
   {"expect": "SZ.overlay.top().meta.auth==='login' && document.querySelector('.auth-reason').textContent===t('auth.reason.order')", "msg": "gated action opens the login sheet with its reason"}
  ]
 },
 {
  "name": "auth-login-sheet-back",
  "hash": "home",
  "session": "guest",
  "steps": [
   {"eval": "SZ.requireLogin(t('auth.reason.gift')),true"},
   {"click": ".auth-login-sheet [data-action=auth-phone]"},
   {"expect": "SZ.overlay.top().meta.auth==='phone' && SZ.overlay.depth()===2", "msg": "phone screen over the sheet"},
   {"back": true},
   {"expect": "SZ.overlay.top().meta.auth==='login'", "msg": "back returns to the sheet"},
   {"back": true},
   {"expect": "SZ.overlay.depth()===0", "msg": "back closes the sheet"}
  ]
 },
 {
  "name": "auth-switcher",
  "hash": "me",
  "session": "demo",
  "steps": [
   {"eval": "ShizhongAuth.open('switch'),true"},
   {"expect": "SZ.overlay.top().meta.auth==='switch' && !!document.querySelector('.auth-account[aria-current=true][data-id=demo]')", "msg": "demo marked current"}
  ]
 },
 {
  "name": "auth-switcher-add",
  "hash": "me",
  "session": "demo",
  "steps": [
   {"eval": "ShizhongAuth.open('switch'),true"},
   {"click": ".auth-switch-sheet [data-act=add]"},
   {"expect": "SZ.overlay.top().meta.auth==='welcome' && !!document.querySelector('[data-auth=welcome] [data-action=close]')", "msg": "welcome (dismissible) for adding an account"},
   {"shot": "welcome"},
   {"back": true},
   {"expect": "SZ.overlay.depth()===0", "msg": "back closes it"}
  ]
 },
 {
  "name": "auth-switcher-signout",
  "hash": "me",
  "session": "demo",
  "steps": [
   {"eval": "ShizhongAuth.open('switch'),true"},
   {"click": ".auth-switch-sheet [data-act=signout]"},
   {"expect": "!!document.querySelector('.sz-confirm')", "msg": "sign-out asks first"}
  ]
 },
 {
  "name": "auth-demo-one-tap",
  "hash": "home",
  "session": "none",
  "steps": [
   {"click": "[data-auth=welcome] [data-action=auth-demo]", "settle": 2500},
   {"expect": "window.SZ_BOOTED && SZ.session.isDemo && SZ.overlay.depth()===0 && state.wallet > 1000000", "msg": "one tap into the demo account"}
  ]
 }
]
