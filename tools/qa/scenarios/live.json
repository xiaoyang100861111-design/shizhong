 },
 {
  "name": "live-gift-panel",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1200
   },
   {
    "click": ".lr-room [data-action=lr-gifts]"
   },
   {
    "wait": 500
   },
   {
    "expect": "SZ.overlay.top().meta.kind==='lr-gifts' && document.querySelectorAll('.lr-sheet-gifts .lr-gift-tile').length>=8",
    "msg": "gift panel"
   },
   {
    "expect": "[...document.querySelectorAll('.lr-sheet-gifts .lr-gift-tile img')].every(i=>/gift-art\\//.test(i.getAttribute('src')))",
    "msg": "tiles use the gift-art manifest"
   }
  ]
 },
 {
  "name": "live-gift-select-inplace",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1200
   },
   {
    "click": ".lr-room [data-action=lr-gifts]"
   },
   {
    "wait": 500
   },
   {
    "click": "[data-action=lr-gift-tab][data-id=盛世华章]"
   },
   {
    "wait": 300
   },
   {
    "eval": "(()=>{const s=SZ.overlay.top().el.querySelector('.lr-gift-body');s.scrollTop=420;window.__sheet=s;window.__st=s.scrollTop;const tiles=s.querySelectorAll('.lr-gift-tile');window.__tile=tiles[tiles.length-2];window.__tile.focus({preventScroll:true});window.__tile.click();return true})()"
   },
   {
    "wait": 300
   },
   {
    "expect": "SZ.overlay.top().el.querySelector('.lr-gift-body')===window.__sheet && Math.abs(window.__sheet.scrollTop-window.__st)<2 && window.__tile.isConnected && window.__tile.getAttribute('aria-pressed')==='true' && document.activeElement===window.__tile",
    "msg": "selection updates in place (scroll and focus kept)"
   },
   {
    "expect": "document.querySelector('.lr-gift-detail strong').textContent===window.__tile.querySelector('.lr-gift-name').textContent",
    "msg": "detail shows the selected gift"
   },
   {
    "click": "[data-action=lr-gift-tab][data-id=大马风情]"
   },
   {
    "wait": 300
   },
   {
    "expect": "document.querySelectorAll('.lr-sheet-gifts .lr-gift-tile').length===12",
    "msg": "Malaysia series tab"
   }
  ]
 },
 {
  "name": "live-gift-combo",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1200
   },
   {
    "eval": "window.__h=state.live.giftHistory.length, window.__p=state.points, true"
   },
   {
    "click": ".lr-room [data-action=lr-gifts]"
   },
   {
    "wait": 400
   },
   {
    "click": "[data-action=lr-send-gift]"
   },
   {
    "wait": 300
   },
   {
    "expect": "SZ.overlay.top().meta.kind==='room' && !!document.querySelector('.lr-room .lr-gift-btn.lr-combo[data-action=lr-combo]')",
    "msg": "send button becomes combo"
   },
   {
    "click": ".lr-room [data-action=lr-combo]",
    "settle": 200
   },
   {
    "expect": "state.live.giftHistory.length===Math.min(100,window.__h+2) && state.points<window.__p && /2/.test(document.querySelector('.lr-combo-text').textContent)",
    "msg": "combo sends again"
   },
   {
    "shot": "effect"
   },
   {
    "wait": 1600
   },
   {
    "expect": "document.querySelectorAll('.lr-room .lr-msg-hostline').length>0",
    "msg": "host thanks after the gift"
   },
   {
    "wait": 2200
   },
   {
    "expect": "!document.querySelector('.lr-room .lr-combo')",
    "msg": "combo expires after 3 s"
   },
   {
    "expect": "state.sentGifts.length<=200 && state.live.giftHistory.length<=100 && !!state.sentGifts[0].giftId",
    "msg": "capped history with gift ids"
   }
  ]
 },
 {
  "name": "live-swipe",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1200
   },
   {
    "eval": "(()=>{window.__first=SZ.overlay.top().meta.hostId;const el=document.querySelector('.lr-room .lr-caption');const tp=y=>new Touch({identifier:1,target:el,clientX:200,clientY:y});el.dispatchEvent(new TouchEvent('touchstart',{touches:[tp(600)],changedTouches:[tp(600)],bubbles:true,cancelable:true}));for(const y of [585,540,440,300])el.dispatchEvent(new TouchEvent('touchmove',{touches:[tp(y)],changedTouches:[tp(y)],bubbles:true,cancelable:true}));el.dispatchEvent(new TouchEvent('touchend',{touches:[],changedTouches:[tp(300)],bubbles:true,cancelable:true}));return true})()"
   },
   {
    "wait": 900
   },
   {
    "expect": "SZ.overlay.depth()===1 && SZ.overlay.top().meta.hostId!==window.__first",
    "msg": "swipe up opens the next room in the same layer"
   },
   {
    "eval": "ShizhongLive.prev(), true"
   },
   {
    "wait": 900
   },
   {
    "expect": "SZ.overlay.top().meta.hostId===window.__first",
    "msg": "prev returns to the first room"
   },
   {
    "expect": "!!document.querySelector('.lr-peek-next img') && !!document.querySelector('.lr-peek-prev img')",
    "msg": "neighbour covers pre-warmed"
   }
  ]
 },
 {
  "name": "live-next-filter",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=live-filter][data-id=travel]"
   },
   {
    "wait": 600
   },
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1200
   },
   {
    "eval": "ShizhongLive.next(), true"
   },
   {
    "wait": 900
   },
   {
    "expect": "people.find(p=>p.id===SZ.overlay.top().meta.hostId).topic==='旅行分享'",
    "msg": "next room respects the Live filter"
   }
  ]
 },
 {
  "name": "live-likes",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1000
   },
   {
    "eval": "window.__id=SZ.overlay.top().meta.hostId, window.__l=Number(state.live.likes[window.__id])||0, true"
   },
   {
    "click": ".lr-room [data-action=lr-like]",
    "settle": 100
   },
   {
    "click": ".lr-room [data-action=lr-like]"
   },
   {
    "wait": 500
   },
   {
    "expect": "state.live.likes[window.__id]===window.__l+2 && JSON.parse(localStorage.getItem(SZ.store.key())).live.likes[window.__id]===window.__l+2",
    "msg": "likes persist per host"
   }
  ],
  "serverSkip": true,
  "serverNote": "reads the local save"
 },
 {
  "name": "live-report",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1000
   },
   {
    "click": ".lr-room [data-action=lr-more]"
   },
   {
    "wait": 400
   },
   {
    "shot": "more"
   },
   {
    "click": ".lr-sheet-more [data-action=lr-report]"
   },
   {
    "wait": 400
   },
   {
    "submit": ".lr-report"
   },
   {
    "expect": "!document.querySelector('.lr-report .form-error').hidden",
