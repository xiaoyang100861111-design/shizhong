 {
  "name": "live-start",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=start-live]"
   },
   {
    "wait": 400
   },
   {
    "expect": "SZ.overlay.top().meta.kind==='lr-start' && SZ.overlay.depth()===1",
    "msg": "start-live form (live module, not the flows fallback)"
   },
   {
    "eval": "document.querySelector('#lr-start-title').value='', true"
   },
   {
    "submit": ".lr-start"
   },
   {
    "expect": "!document.querySelector('#lr-start-error').hidden",
    "msg": "title required"
   },
   {
