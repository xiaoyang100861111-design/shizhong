[
 {
  "name": "live-room",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 2600
   },
   {
    "expect": "ShizhongLive.isOpen() && SZ.overlay.top().meta.kind==='room' && document.querySelectorAll('.lr-room .lr-msg').length>=6",
    "msg": "room is an overlay layer with seeded comments"
   }
  ]
 },
 {
  "name": "live-room-back",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1500
   },
   {
    "back": true
   },
   {
    "wait": 600
   },
   {
    "expect": "document.querySelectorAll('#overlay-root > [data-sz-layer]').length===0",
    "msg": "back closes the live room"
   },
