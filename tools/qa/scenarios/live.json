    "expect": "state.feedback[0].context==='live' && state.feedback[0].reason==='spam' && SZ.overlay.top().meta.kind==='room'",
    "msg": "report saved, back in the room"
   }
  ],
  "serverSteps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1000
   },
   {
    "click": ".lr-room [data-action=lr-more]"
   },
   {
    "wait": 400
   },
   {
    "shot": "more"
   },
   {
    "click": ".lr-sheet-more [data-action=lr-report]"
   },
   {
    "wait": 400
   },
   {
    "submit": ".lr-report"
   },
   {
    "expect": "!document.querySelector('.lr-report .form-error').hidden",
    "msg": "reason is required"
   },
   {
    "click": ".lr-report input[name=reason][value=spam]"
   },
   {
    "submit": ".lr-report"
   },
   {
    "wait": 300
   },
   {
    "expect": "state.feedback[0].reason==='spam' && ['live-room','person'].includes(state.feedback[0].targetType) && SZ.overlay.top().meta.kind==='room'",
    "msg": "report saved on the server, back in the room"
   }
  ]
 },
 {
  "name": "live-block-host",
  "hash": "live",
  "steps": [
   {
    "click": "[data-action=room]"
   },
   {
    "wait": 1000
   },
   {
    "eval": "window.__host=SZ.overlay.top().meta.hostId, true"
   },
   {
