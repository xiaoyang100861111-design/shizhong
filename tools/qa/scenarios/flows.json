  "steps": [
   {
    "eval": "SZ.actions.dispatch('edit-profile'),true"
   },
   {
    "eval": "(async()=>{await new Promise(r=>setTimeout(r,300));const c=document.createElement('canvas');c.width=900;c.height=600;const g=c.getContext('2d');g.fillStyle='rgb(230,120,90)';g.fillRect(0,0,900,600);g.fillStyle='rgb(40,90,160)';g.fillRect(300,150,300,300);const blob=await new Promise(r=>c.toBlob(r,'image/png'));const f=new File([blob],'photo.png',{type:'image/png'});const dt=new DataTransfer();dt.items.add(f);const inp=document.querySelector('.flows-profile [data-flows-upload]');inp.files=dt.files;inp.dispatchEvent(new Event('change',{bubbles:true}));return true})()"
   },
