[
 {
  "name": "flows-settings",
  "hash": "me",
  "steps": [
   {
    "eval": "SZ.actions.dispatch('settings'),true"
   },
   {
    "expect": "!!SZ.overlay.top()?.el.matches('.flows-settings')",
    "msg": "settings screen open"
   },
   {
    "expect": "!!document.querySelector('.flows-settings [data-action=flows-logout]')",
    "msg": "sign-out row for a signed-in account"
   }
  ]
 },
 {
  "name": "flows-settings-scrolled",
  "hash": "me",
  "steps": [
   {
    "eval": "SZ.actions.dispatch('settings'),true"
   },
   {
    "eval": "SZ.overlay.top().el.scrollTo(0, 99999),true"
   }
  ]
 },
 {
  "name": "flows-settings-back",
  "hash": "me",
  "steps": [
   {
    "eval": "SZ.actions.dispatch('settings'),true"
   },
   {
    "click": ".flows-settings [data-action=addresses]"
   },
   {
    "expect": "SZ.overlay.depth()===2",
    "msg": "addresses pushed over settings"
   },
   {
    "back": true
   },
   {
    "wait": 500
   },
   {
    "expect": "SZ.overlay.depth()===1 && SZ.overlay.top().el.matches('.flows-settings')",
    "msg": "back returns to settings"
   },
   {
    "back": true
   },
   {
    "wait": 500
   },
   {
    "expect": "SZ.overlay.depth()===0",
    "msg": "second back closes settings"
   }
  ]
 },
 {
