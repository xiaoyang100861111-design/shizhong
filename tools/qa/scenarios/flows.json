 {
  "name": "flows-compose-photo",
  "hash": "social",
  "steps": [
   {
    "eval": "SZ.actions.dispatch('compose'),true"
   },
   {
    "eval": "(async()=>{await new Promise(r=>setTimeout(r,300));const c=document.createElement('canvas');c.width=900;c.height=600;const g=c.getContext('2d');g.fillStyle='rgb(230,120,90)';g.fillRect(0,0,900,600);g.fillStyle='rgb(40,90,160)';g.fillRect(300,150,300,300);const blob=await new Promise(r=>c.toBlob(r,'image/png'));const f=new File([blob],'photo.png',{type:'image/png'});const dt=new DataTransfer();dt.items.add(f);const inp=document.querySelector('.flows-compose [data-flows-upload]');inp.files=dt.files;inp.dispatchEvent(new Event('change',{bubbles:true}));return true})()"
   },
   {
    "wait": 1500
   },
   {
    "expect": "!!document.querySelector('.flows-compose .flows-upload.has-file img')",
    "msg": "photo preview shown"
   },
   {
    "shot": "preview"
   },
   {
    "type": ".flows-compose [name=text]",
    "value": "Sunset colours tonight."
   },
   {
    "submit": ".flows-compose form"
   },
   {
    "wait": 800
   },
   {
    "expect": "SZ.media.isRef(state.posts[0].image) && !JSON.stringify(state).includes('data:image/png')",
    "msg": "photo stored in SZ.media, not in state"
   }
  ]
 },
 {
