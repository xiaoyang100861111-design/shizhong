 {
  "name": "flows-recharge",
  "hash": "me",
  "steps": [
   {
    "eval": "window.__before=state.wallet; SZ.actions.dispatch('wallet'); SZ.actions.dispatch('recharge'); true"
   },
   {
    "click": ".flows-amount input[value='200']"
   },
   {
    "click": ".flows-method input[value=fpx]"
   },
   {
    "shot": "form"
   },
   {
    "submit": ".flows-recharge form"
   },
   {
    "wait": 300
   },
   {
    "shot": "authorising"
   },
   {
    "wait": 1800
   },
   {
    "expect": "Math.abs(state.wallet-(window.__before+200))<0.001",
    "msg": "wallet credited"
   },
   {
    "expect": "state.bills[0].kind==='recharge' && state.bills[0].method==='fpx'",
    "msg": "bill recorded"
   },
   {
    "click": ".flows-recharge [data-action=close]"
   },
   {
    "wait": 300
   },
   {
    "expect": "SZ.overlay.top()?.el.matches('.flows-wallet')",
    "msg": "back on wallet"
   }
  ],
  "serverSkip": true,
  "serverNote": "server mode: top-ups are crypto / bank transfer (tools/qa/server_smoke.py)"
 },
