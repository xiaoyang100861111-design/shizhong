 {
  "name": "private-low-balance",
  "hash": "live",
  "setup": [
   "SZ.store.detach()",
   "localStorage.removeItem('sz:v2:state:demo')"
  ],
  "steps": [
   {
    "wait": 800
   },
   {
    "click": "[data-action=live-tab][data-id=private]"
   },
   {
    "wait": 900
   },
   {
    "eval": "(ShizhongPrivate.config.timeScale=20,true)"
   },
   {
    "click": "[data-action=oo-call]"
   },
   {
    "wait": 2000
   },
   {
    "eval": "ShizhongPrivate.simulate('lowBalance')"
   },
   {
    "expect": "!!(!document.querySelector('.oo-low').hidden && document.querySelector('.oo-runway.is-low'))",
    "msg": "low-balance prompt",
    "settle": 100
   },
   {
    "shot": "low"
   },
   {
    "wait": 7000
   },
   {
    "expect": "!!(document.querySelector('.oo-room').dataset.phase==='ended' && state.oneToOne.calls[0].reason==='balance')",
    "msg": "auto end at zero"
   }
  ],
  "serverSkip": true,
  "serverNote": "the server bills and ends calls (PrivateModule)"
 },
 {
  "name": "private-no-answer",
  "hash": "live",
  "setup": [
   "SZ.store.detach()",
   "localStorage.removeItem('sz:v2:state:demo')"
  ],
  "steps": [
   {
    "wait": 800
   },
   {
    "click": "[data-action=live-tab][data-id=private]"
   },
   {
    "wait": 900
   },
   {
    "eval": "(ShizhongPrivate.config.noAnswerMs=600,ShizhongPrivate.enter(people.find(p=>p.liveMode==='private'&&!p.online).id),true)"
   },
   {
    "wait": 1400
   },
   {
    "expect": "!!(document.querySelector('.oo-room').dataset.phase==='ended' && state.oneToOne.calls[0].reason==='timeout')",
    "msg": "no answer ends as missed"
   }
  ]
 },
