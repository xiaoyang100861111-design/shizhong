        "value": "这条消息用来测试长按菜单"
      },
      {
        "submit": ".cx-composer"
      },
      {
        "eval": "(()=>{const b=[...document.querySelectorAll('.cx-row.is-self .cx-bubble')].pop();b.dispatchEvent(new MouseEvent('contextmenu',{bubbles:true,cancelable:true}));return true})()"
      },
      {
        "wait": 300
      },
      {
        "expect": "!!SZ.overlay.$('[data-action=cx-m-recall]') && !!SZ.overlay.$('[data-action=cx-m-quote]')",
        "msg": "menu offers recall and reply for a fresh own message"
      }
    ]
  },
