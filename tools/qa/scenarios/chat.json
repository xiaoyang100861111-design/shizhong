[
  {
    "name": "chat-friend",
    "hash": "comms",
    "steps": [
      {
        "expect": "window.ShizhongChat && ShizhongChat.unreadCount() >= 3",
        "msg": "demo account starts with unread chats"
      },
      {
        "click": "[data-action=chat][data-id=p1]"
      },
      {
        "wait": 700
      },
      {
        "expect": "!!document.querySelector('.cx-screen .cx-log .cx-row')",
        "msg": "chat screen renders messages"
      },
      {
        "expect": "ShizhongChat.unread('p1') === 0",
        "msg": "opening a chat marks it read"
      }
    ],
    "setup": [
      "window.SZ&&(SZ.store.flush=()=>{})",
      "localStorage.removeItem('sz:v2:state:demo')"
    ]
  },
  {
    "name": "chat-back",
    "hash": "comms",
    "steps": [
      {
        "click": "[data-action=chat][data-id=p1]"
      },
      {
        "wait": 600
      },
      {
        "back": true
      },
      {
        "wait": 500
      },
      {
        "expect": "SZ.overlay.depth() === 0",
        "msg": "back button closes the chat"
      }
    ]
  },
  {
    "name": "chat-plus-panel",
    "hash": "comms",
    "steps": [
      {
        "click": "[data-action=chat][data-id=p1]"
      },
      {
        "wait": 500
      },
      {
        "click": "[data-action=cx-more]"
      },
      {
        "expect": "!document.querySelector('.cx-tools').hidden && document.querySelectorAll('.cx-tool').length === 9",
        "msg": "friend chat shows all 9 tools"
      }
    ]
  },
  {
    "name": "chat-emoji-panel",
    "hash": "comms",
    "steps": [
      {
        "click": "[data-action=chat][data-id=p1]"
      },
      {
        "wait": 500
      },
      {
        "click": "[data-action=cx-emoji]"
      },
      {
        "click": ".cx-emoji"
      },
      {
        "click": ".cx-emoji"
      },
      {
        "expect": "document.querySelector('.cx-input').value.length > 0 && !document.querySelector('.cx-send').hidden",
        "msg": "emoji inserted, send button visible"
      }
    ]
  },
  {
    "name": "chat-send-reply",
    "hash": "comms",
    "steps": [
      {
        "click": "[data-action=chat][data-id=p1]"
      },
      {
        "wait": 500
      },
      {
        "eval": "window.__rows = document.querySelectorAll('.cx-log .cx-row[data-mid]').length, true"
      },
      {
        "type": ".cx-input",
        "value": "周末有空一起去喝咖啡吗？"
      },
      {
        "submit": ".cx-composer"
      },
      {
        "expect": "document.querySelectorAll('.cx-log .cx-row[data-mid]').length === window.__rows + 1",
        "msg": "sending appends exactly one bubble"
      },
      {
        "expect": "document.querySelector('.cx-row.is-self:last-of-type .cx-tick, .cx-log .cx-row.is-self:nth-last-child(2) .cx-tick')?.dataset.state === 'sent'",
        "msg": "new message has a single tick"
      },
      {
        "expect": "(async()=>{for(let i=0;i<60;i++){if(document.querySelector('.cx-status.is-typing')&&!document.querySelector('.cx-typing').hidden)return true;await new Promise(r=>setTimeout(r,80))}return false})()",
        "msg": "typing indicator while the friend is replying"
      },
      {
        "shot": "typing"
      },
      {
        "expect": "(async()=>{for(let i=0;i<60;i++){if(document.querySelectorAll('.cx-log .cx-row[data-mid]').length>=window.__rows+2)return true;await new Promise(r=>setTimeout(r,80))}return false})()",
        "msg": "friend replied"
      },
      {
        "expect": "!document.querySelector('.cx-tick[data-state=sent]') && !document.querySelector('.cx-status.is-typing')",
        "msg": "ticks turn to read, typing ends"
      }
    ]
  },
  {
    "name": "chat-message-menu",
    "hash": "comms",
    "steps": [
      {
        "click": "[data-action=chat][data-id=p1]"
      },
      {
        "wait": 500
      },
      {
