    "steps": [
      {
        "click": "[data-action=chat][data-id=p1]"
      },
      {
        "wait": 500
      },
      {
        "eval": "window.__n = document.querySelectorAll('.cx-log .cx-row[data-mid]').length, true"
      },
      {
        "eval": "(()=>{const b=[...document.querySelectorAll('.cx-row:not(.is-self) .cx-b-text')].pop();b.dispatchEvent(new MouseEvent('contextmenu',{bubbles:true,cancelable:true}));return true})()"
      },
      {
        "wait": 300
