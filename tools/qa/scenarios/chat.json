  {
    "name": "chat-image",
    "hash": "comms",
    "steps": [
      {
        "click": "[data-action=chat][data-id=p1]"
      },
      {
        "wait": 500
      },
      {
        "eval": "(async()=>{const c=document.createElement('canvas');c.width=640;c.height=480;const x=c.getContext('2d');const g=x.createLinearGradient(0,0,640,480);g.addColorStop(0,'#f6b26b');g.addColorStop(1,'#6fa8dc');x.fillStyle=g;x.fillRect(0,0,640,480);const b=await new Promise(r=>c.toBlob(r,'image/png'));const dt=new DataTransfer();dt.items.add(new File([b],'sunset.png',{type:'image/png'}));const i=document.querySelector('.cx-file-input');i.dataset.kind='image';i.files=dt.files;i.dispatchEvent(new Event('change'));return true})()"
      },
      {
        "wait": 1200
      },
      {
        "expect": "!!document.querySelector('.cx-row[data-type=image] img.cx-photo')",
        "msg": "photo bubble with inline thumbnail"
      },
