  ]
 },
 {
  "name": "catalog-goods-cart",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=market]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=catalog-add-cart]"
