[
 {
  "name": "catalog-home",
  "hash": "home",
  "steps": [
   {
    "expect": "!!(!!document.querySelector('.checkout-home .app-bar') && document.querySelectorAll('.checkout-card').length >= 6)",
    "msg": "home shows app bar and product cards"
   }
  ]
 },
 {
  "name": "catalog-home-scrolled",
  "hash": "home",
  "steps": [
   {
    "eval": "document.querySelector('#app').scrollTo(0, 700), true"
   },
   {
    "click": "[data-action=home-filter][data-id=rating]"
   },
   {
    "expect": "!!(document.querySelector('[data-action=home-filter][data-id=rating]').getAttribute('aria-pressed')==='true')",
    "msg": "filter chip pressed"
   }
  ]
 },
 {
  "name": "catalog-home-load-more",
  "hash": "home",
  "steps": [
   {
    "eval": "window.__n=document.querySelectorAll('#app .checkout-card').length, true"
   },
   {
    "click": "#app [data-action=load-more]"
   },
   {
    "expect": "!!(document.querySelectorAll('#app .checkout-card').length === window.__n + 20)",
    "msg": "load more appends 20 cards in place"
   }
  ]
 },
 {
  "name": "catalog-all-categories",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=all]"
   },
   {
    "expect": "!!(SZ.overlay.depth()===1 && document.querySelectorAll('.checkout-cat-row').length===13)",
    "msg": "13 categories listed"
   }
  ]
 },
 {
  "name": "catalog-category",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "expect": "!!(SZ.overlay.top().meta.category==='clean' && SZ.overlay.$('.checkout-card'))",
    "msg": "category screen with cards"
   }
  ]
 },
 {
  "name": "catalog-category-sort",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=food]"
   },
   {
    "click": "[data-action=catalog-category-sort]"
   },
   {
    "click": "[data-option=priceAsc]"
   },
   {
    "wait": 300
   },
   {
    "expect": "!!((()=>{const p=[...SZ.overlay.top().el.querySelectorAll('.checkout-card .price')].map(e=>parseFloat(e.textContent.replace(/[^0-9.]/g,'')));return p.length>3 && p.every((v,i)=>!i||v>=p[i-1])})())",
    "msg": "sorted by price ascending"
   },
   {
    "click": "[data-action=catalog-category-city]"
   },
   {
    "shot": "city-sheet"
   },
   {
    "click": "[data-option=all]"
   },
   {
    "wait": 300
   },
   {
    "expect": "!!(SZ.overlay.depth()===1)",
    "msg": "picker closed back to category"
   }
  ]
 },
 {
  "name": "catalog-category-search",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=q]",
    "value": "空调"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=category-search]"
   },
   {
    "wait": 1500
   },
   {
    "expect": "!!(SZ.overlay.top().el.querySelectorAll('.checkout-card').length > 0)",
    "msg": "category search finds aircon cleaning"
   }
  ]
 },
 {
  "name": "catalog-service-detail",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "expect": "!!(SZ.overlay.top().meta.view==='service' && SZ.overlay.$('.checkout-bottom-bar [data-action=book-service]'))",
    "msg": "detail with sticky booking bar"
   }
  ]
 },
 {
  "name": "catalog-detail-scrolled",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=guide]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "eval": "SZ.overlay.top().el.scrollTo(0, 1500), true"
   }
  ]
 },
 {
  "name": "catalog-detail-back",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "eval": "SZ.overlay.top().el.scrollTo(0, 600), true"
   },
   {
    "eval": "[...SZ.overlay.top().el.querySelectorAll('[data-action=service]')].find(b=>{const r=b.getBoundingClientRect();return r.top>150&&r.bottom<innerHeight-80}).click(), true"
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__y=SZ.overlay.layers()[0].el.scrollTop, true"
   },
   {
    "back": true
   },
   {
    "wait": 600
   },
   {
    "expect": "!!(SZ.overlay.depth()===1 && SZ.overlay.top().meta.category==='clean' && window.__y>300 && Math.abs(SZ.overlay.top().el.scrollTop-window.__y)<2)",
    "msg": "back returns to category list with scroll intact"
   }
  ]
 },
 {
  "name": "catalog-save-toggle",
  "hash": "home",
  "steps": [
   {
    "click": "#app [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__saved=state.saved.length, true"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=save-service]"
   },
   {
    "expect": "!!(state.saved.length===window.__saved+1 && SZ.overlay.$('[data-action=save-service]').getAttribute('aria-pressed')==='true')",
    "msg": "saved in place"
   }
  ]
 },
 {
  "name": "catalog-request-form",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "expect": "!!(SZ.overlay.top().meta.view==='request')",
    "msg": "request form sheet"
   }
  ]
 },
 {
  "name": "catalog-request-validation",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=car]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "12"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "expect": "!!(SZ.overlay.top().meta.view==='request' && SZ.overlay.$('[aria-invalid=true]'))",
    "msg": "invalid phone is flagged inline"
   }
  ]
 },
 {
  "name": "catalog-confirm",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "expect": "!!(SZ.overlay.top().meta.view==='confirm' && SZ.overlay.depth()===4)",
    "msg": "confirm screen pushed over the form"
   }
  ]
 },
 {
  "name": "catalog-confirm-back",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child textarea[name=note]",
    "value": "keep this draft"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "back": true
   },
   {
    "wait": 500
   },
   {
    "expect": "!!(SZ.overlay.top().meta.view==='request' && SZ.overlay.$('textarea[name=note]').value==='keep this draft')",
    "msg": "back from confirm keeps the form draft"
   }
  ]
 },
 {
  "name": "catalog-pay-wallet",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "type": "[data-sz-layer]:last-child textarea[name=address]",
    "value": "Jalan Ampang 12, Unit 3A"
   },
   {
    "eval": "window.__w=state.wallet, window.__o=state.orders.length, true"
   },
   {
    "click": "[data-sz-layer]:last-child [data-checkout=place]"
   },
   {
    "wait": 800
   },
   {
    "expect": "!!(state.orders.length===window.__o+1 && state.wallet < window.__w && state.orders[0].status==='pending' && state.orders[0].history.length===1 && state.bills[0].orderId===state.orders[0].id)",
    "msg": "order, wallet and bill written together"
   },
   {
    "expect": "!!(SZ.overlay.top().el.matches('.overlay-backdrop') && SZ.overlay.depth()===3)",
    "msg": "success sheet over the service detail"
   }
  ]
 },
 {
  "name": "catalog-pay-tng",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=guide]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-checkout=method][data-value=tng]"
   },
   {
    "eval": "window.__w=state.wallet, true"
   },
   {
    "click": "[data-sz-layer]:last-child [data-checkout=place]"
   },
   {
    "shot": "authorise"
   },
   {
    "click": "[data-sz-layer]:last-child [data-auth='1']"
   },
   {
    "wait": 1500
   },
   {
    "expect": "!!(state.wallet===window.__w && state.orders[0].payMethod==='tng' && state.orders[0].paid)",
    "msg": "external method does not touch the wallet"
   }
  ],
  "serverSteps": [
   {
    "click": "[data-action=category][data-id=guide]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "expect": "!!(SZ.overlay.$('[data-checkout=method][data-value=tng]') === null || SZ.overlay.$('[data-checkout=method][data-value=tng]').dataset.off === 'true')",
    "msg": "server mode: only the wallet can pay this phase (TNG shown as unavailable)"
   }
  ]
 },
 {
  "name": "catalog-order-confirmed",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "type": "[data-sz-layer]:last-child textarea[name=address]",
    "value": "Jalan Ampang 12"
   },
   {
    "click": "[data-sz-layer]:last-child [data-checkout=place]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=order-detail]"
   },
   {
    "eval": "state.orders[0].autoConfirmAt=Date.now(), true"
   },
   {
    "wait": 3800
   },
   {
    "expect": "!!(state.orders[0].status==='confirmed' && (state.messages['merchant:'+state.orders[0].serviceId]||[]).length>0 && SZ.overlay.$('.checkout-status-confirmed'))",
    "msg": "merchant auto-confirms, chat message and live timeline"
   }
  ],
  "serverSteps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "type": "[data-sz-layer]:last-child textarea[name=address]",
    "value": "Jalan Ampang 12"
   },
   {
    "click": "[data-sz-layer]:last-child [data-checkout=place]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=order-detail]"
   },
   {
    "wait": 22000
   },
   {
    "expect": "!!(state.orders[0].status==='confirmed' && (state.messages['merchant:'+state.orders[0].serviceId]||[]).length>0 && SZ.overlay.$('.checkout-status-confirmed'))",
    "msg": "server auto-confirms (orders.autoConfirm*Seconds), merchant chat message and live timeline"
   }
  ]
 },
 {
  "name": "catalog-order-cancel",
  "hash": "home",
  "steps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "type": "[data-sz-layer]:last-child textarea[name=address]",
    "value": "Jalan Ampang 12"
   },
   {
    "click": "[data-sz-layer]:last-child [data-checkout=place]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=order-detail]"
   },
   {
    "eval": "window.__w=state.wallet, window.__pay=state.orders[0].payable, true"
   },
   {
    "click": "[data-sz-layer]:last-child .checkout-bottom-bar [data-action=cancel-order]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-reason=plans]"
   },
   {
    "shot": "cancel-sheet"
   },
   {
    "click": "[data-sz-layer]:last-child [data-cancel-confirm]"
   },
   {
    "expect": "!!(state.orders[0].status==='cancelled' && Math.abs(state.wallet-(window.__w+window.__pay))<0.001 && state.bills[0].type==='order-refund')",
    "msg": "cancel refunds to wallet with a bill"
   }
  ],
  "serverSteps": [
   {
    "click": "[data-action=category][data-id=clean]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=service]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=book-service]"
   },
   {
    "type": "[data-sz-layer]:last-child input[name=phone]",
    "value": "+60 12-345 6789"
   },
   {
    "submit": "[data-sz-layer]:last-child form[data-catalog-form=request]"
   },
   {
    "type": "[data-sz-layer]:last-child textarea[name=address]",
    "value": "Jalan Ampang 12"
   },
   {
    "click": "[data-sz-layer]:last-child [data-checkout=place]"
   },
   {
    "wait": 800
   },
   {
    "click": "[data-sz-layer]:last-child [data-action=order-detail]"
   },
   {
    "eval": "window.__w=state.wallet, window.__pay=state.orders[0].payable, true"
   },
   {
    "click": "[data-sz-layer]:last-child .checkout-bottom-bar [data-action=cancel-order]"
   },
   {
    "click": "[data-sz-layer]:last-child [data-reason=plans]"
   },
   {
    "shot": "cancel-sheet"
   },
   {
    "click": "[data-sz-layer]:last-child [data-cancel-confirm]"
   },
   {
    "expect": "!!(state.orders[0].status==='cancelled' && Math.abs(state.wallet-(window.__w+window.__pay))<0.001 && state.bills[0].kind==='refund' && state.bills[0].orderId===state.orders[0].id)",
    "msg": "cancel refunds to wallet with a refund bill linked to the order"
   }
  ]
 },
 {
  "name": "catalog-order-review",
  "hash": "home",
  "steps": [
